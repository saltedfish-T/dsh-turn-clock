{
  "name": "dsh-turn-clock",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
    "repository": {
    "type": "git",
    "url": "git+https://github.com/saltedfish-T/dsh-turn-clock.git"
  },
  "description": "Right-sidebar tab that lists every turn of a session with its date and start time, and jumps the conversation to the turn you pick.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "turns",
    "timeline",
    "navigation",
    "sidebar"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
